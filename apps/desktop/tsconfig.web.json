{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "isolatedModules": true,
    "types": [],
    "paths": {
      "@editor": ["../../packages/editor/src/index.ts"],
      "@editor/*": ["../../packages/editor/src/*"],
      "@tokens/*": ["../../design-tokens/*"]
    }
  },
  "include": ["src/renderer", "src/preload/api.d.ts", "src/preload/index.ts", "../../packages/editor/src"]
}
